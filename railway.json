{
    "$schema": "https://railway.app/railway.schema.json",
    "build": {
        "builder": "DOCKERFILE",
        "dockerfilePath": "backend/Dockerfile",
        "context": "."
    },
    "deploy": {
        "startCommand": "sh backend/entrypoint.sh",
        "restartPolicyType": "ON_FAILURE"
    }
}